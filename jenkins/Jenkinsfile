pipeline {
    agent any

    options {
        timestamps()
    }

    environment {
        IMAGE_NAME = 'myapp'
        IMAGE_TAG  = "${env.BUILD_NUMBER}"
        RELEASE    = 'myapp'
        NAMESPACE  = 'dev'
        CHART_DIR  = 'helm/myapp'
        PATH = "C:\\Program Files\\Git\\cmd;C:\\helm;C:\\kubectl;${env.PATH}"
    }

    stages {
        stage('Checkout') {
            steps { checkout scm }
        }

        stage('Lint Helm Chart') {
            steps {
                bat 'helm lint %CHART_DIR% -f %CHART_DIR%/values-dev.yaml'
                bat 'helm template %RELEASE% %CHART_DIR% -f %CHART_DIR%/values-dev.yaml > NUL'
            }
        }

        stage('Build Docker Image') {
            steps {
                bat 'docker build -t %IMAGE_NAME%:%IMAGE_TAG% app/'
            }
        }

        stage('Deploy with Helm') {
            steps {
                bat '''
                  helm upgrade --install %RELEASE% %CHART_DIR% ^
                    -n %NAMESPACE% --create-namespace ^
                    -f %CHART_DIR%/values-dev.yaml ^
                    --set image.repository=%IMAGE_NAME% ^
                    --set image.tag=%IMAGE_TAG% ^
                    --wait --timeout 120s
                '''
            }
        }

        stage('Verify') {
            steps {
                bat 'kubectl get pods -n %NAMESPACE%'
                bat 'helm status %RELEASE% -n %NAMESPACE%'
            }
        }
    }

    post {
        failure {
            echo 'Deployment failed - rolling back'
            bat 'helm rollback %RELEASE% -n %NAMESPACE% || exit /b 0'
        }
    }
}